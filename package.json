{
  "name": "omniforge",
  "version": "1.2.2",
  "description": "A local-first media downloader, converter, and file utility workbench.",
  "main": "src/main/index.js",
  "author": "OmniForge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "dist": "node scripts/prepare-tools.mjs && electron-builder --win nsis && node scripts/write-installer-hash.mjs",
    "pack": "node scripts/prepare-tools.mjs && electron-builder --dir"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.1",
    "pdf-lib": "^1.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "7zip-bin": "^5.2.0"
  },
  "build": {
    "appId": "com.omniforge.desktop",
    "productName": "OmniForge",
    "icon": "build/icon.ico",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniForge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniForge"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
